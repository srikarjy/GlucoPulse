POSTGRES_USER=glucopulse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=glucopulse

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- Healthcare / FHIR facade (serving). Empty = fail closed. ---
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GLUCOPULSE_AUTH_MODE=            # jwks (production) | hs256 (local dev only)
GLUCOPULSE_JWT_SECRET=           # hs256 only, >= 32 chars
GLUCOPULSE_JWKS_URL=             # jwks mode: authorization server's JWKS endpoint
GLUCOPULSE_ISSUER=               # expected `iss` claim
GLUCOPULSE_AUDIENCE=glucopulse-fhir
GLUCOPULSE_PSEUDONYM_KEY=        # >= 32 chars; HMAC key for patient pseudonyms
GLUCOPULSE_FHIR_DB_PASSWORD=     # password for the read-only glucopulse_fhir role
GLUCOPULSE_PUBLIC_URL=https://localhost:8443
